# ── backend ──────────────────────────────
ISGEC_BACKEND_PORT=8001
ISGEC_FRONTEND_PORT=3001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DATA_DIR=./data
UPLOAD_DIR=./uploads
DATABASE_URL=sqlite:///./data/adv.db

# CORS — comma-separated origins allowed to hit the API
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# LLM provider: gemini (default) or ollama (zero-API, on-prem)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

GEMINI_TIMEOUT_SEC=20
MAX_UPLOAD_MB=100

# ── frontend ─────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8001
