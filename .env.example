# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Keep this file OUT of version control.
GEMINI_API_KEY=

# Gemini model — see https://ai.google.dev/gemini-api/docs/models
# Free-tier friendly options: gemini-2.5-flash, gemini-2.0-flash
# Higher quality but paid: gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Port the backend listens on (serves the frontend too)
PORT=3001

# Where uploaded files + SQLite db live
DATA_DIR=./data
